# ------------------------------------------------------------------
# Dreamz Dezignerz — deploy-time configuration
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored; this example file is committed.
# ------------------------------------------------------------------

# Public production URL (no trailing slash). Set this once the domain is purchased.
# Used for SEO canonicals, sitemap, robots and social share (Open Graph) tags.
NEXT_PUBLIC_SITE_URL=https://www.dreamzdezignerz.com

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Lead / contact form endpoint.
#  - Formspree:  https://formspree.io/f/xxxxxxxx
#  - Web3Forms:  https://api.web3forms.com/submit   (also set the access key below)
# Leave blank to keep forms in demo mode (no data is sent anywhere).
NEXT_PUBLIC_FORM_ENDPOINT=

# Web3Forms access key (ONLY needed if you use Web3Forms as the endpoint above).
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Social profile URLs (optional — improves SEO / knowledge panel via JSON-LD).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
